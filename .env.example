# Kutubi (كتبي) — Environment Configuration Template
# Copy this file to .env for local development or configure in your deployment platform (Vercel).

# Server Configuration
PORT=3000
NODE_ENV=development

# -------------------------------------------------------------
# Local Development Mode (Default)
# Uses local SQLite (better-sqlite3) and local filesystem storage.
# No cloud credentials are required for local mode.
# -------------------------------------------------------------
# DATABASE_PATH=./data/kutubi.db
# STORAGE_ADAPTER=local

# -------------------------------------------------------------
# Production Cloud Mode (Vercel + Turso + Vercel Private Blob)
# Automatically activated when TURSO_DATABASE_URL and
# BLOB_READ_WRITE_TOKEN are present in the environment.
# -------------------------------------------------------------
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxx
# STORAGE_ADAPTER=blob
