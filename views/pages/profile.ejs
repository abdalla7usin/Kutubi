<div class="main-container narrow">
  <!-- Header with Editorial Precision -->
  <header class="flex flex-col gap-1">
    <p class="text-[11px] font-semibold uppercase tracking-[0.08em] text-text-muted">Account</p>
    <h1 class="text-[26px] font-semibold text-text-primary tracking-tight leading-none">Profile</h1>
    <p class="text-[13px] text-text-secondary mt-1">Your reader identity and reading achievements.</p>
  </header>

  <!-- Card 1: Reader Identity -->
  <section class="card card-padded flex flex-col gap-6">
    <div class="flex items-center gap-4">
      <div id="profile-avatar" class="w-[64px] h-[64px] rounded-full bg-[linear-gradient(135deg,#1E1E24,#141418)] border border-[rgba(255,255,255,0.08)] flex items-center justify-center shrink-0 shadow-sm">
        <span class="text-[20px] font-semibold text-text-primary tracking-tight" id="avatar-initials" data-testid="profile-avatar-initials"><%= profile.initials %></span>
      </div>
      <div class="flex flex-col gap-0.5">
        <h2 class="text-[15px] font-semibold text-text-primary tracking-tight">Reader Identity</h2>
        <p class="text-[12px] text-text-secondary">Displayed across your personal reading workspace.</p>
      </div>
    </div>

    <form id="profile-form" action="/profile" method="POST" class="flex flex-col gap-5">
      <label class="form-group">
        <span class="form-label">Display Name</span>
        <input
          id="profile-display-name"
          name="displayName"
          type="text"
          required
          value="<%= profile.displayName %>"
          class="form-input h-9"
        />
      </label>

      <label class="form-group">
        <span class="form-label">Bio / Reading Goal</span>
        <textarea
          id="profile-bio"
          name="bio"
          rows="3"
          class="form-textarea"
          placeholder="What are you currently exploring or reading towards?"
        ><%= profile.bio %></textarea>
      </label>

      <div class="flex justify-end pt-2 border-t border-[rgba(255,255,255,0.06)]">
        <button type="submit" class="btn btn-primary text-[12px] h-9 px-4" id="save-profile-btn">
          <span>Save Changes</span>
        </button>
      </div>
    </form>
  </section>

  <!-- Card 2: Reading Milestone Summary -->
  <section class="card card-padded flex flex-col gap-4">
    <div>
      <h2 class="text-[15px] font-semibold text-text-primary tracking-tight">Reading Milestones</h2>
      <p class="text-[12px] text-text-secondary mt-0.5">Aggregated statistics calculated live from your collection.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      <div class="bg-[rgba(255,255,255,0.02)] border border-[rgba(255,255,255,0.06)] rounded-control p-4 flex flex-col gap-1">
        <span class="text-[11px] font-semibold uppercase tracking-[0.06em] text-text-muted">Books Completed</span>
        <span class="text-[26px] font-semibold text-text-primary tabular-nums tracking-tight" id="milestone-completed">
          <%= stats.completedBooks %>
        </span>
      </div>

      <div class="bg-[rgba(255,255,255,0.02)] border border-[rgba(255,255,255,0.06)] rounded-control p-4 flex flex-col gap-1">
        <span class="text-[11px] font-semibold uppercase tracking-[0.06em] text-text-muted">Total Pages Read</span>
        <span class="text-[26px] font-semibold text-text-primary tabular-nums tracking-tight" id="milestone-pages">
          <%= stats.totalPagesRead.toLocaleString() %>
        </span>
      </div>

      <div class="bg-[rgba(255,255,255,0.02)] border border-[rgba(255,255,255,0.06)] rounded-control p-4 flex flex-col gap-1">
        <span class="text-[11px] font-semibold uppercase tracking-[0.06em] text-text-muted">Top Category</span>
        <span class="text-[16px] font-semibold text-text-primary truncate mt-1" id="milestone-favorite">
          <%= stats.favoriteCategory %>
        </span>
      </div>
    </div>
  </section>
</div>

<script>
  // Live initials calculation as user types in Display Name
  document.addEventListener('DOMContentLoaded', () => {
    const input = document.getElementById('profile-display-name');
    const initialsEl = document.getElementById('avatar-initials');
    if (!input || !initialsEl) return;

    input.addEventListener('input', () => {
      const val = (input.value || '').trim();
      if (!val) {
        initialsEl.textContent = 'K';
        return;
      }
      const parts = val.split(/\s+/).filter(Boolean);
      if (parts.length === 0) {
        initialsEl.textContent = 'K';
      } else if (parts.length === 1) {
        initialsEl.textContent = Array.from(parts[0]).slice(0, 2).join('').toUpperCase();
      } else {
        const char1 = Array.from(parts[0])[0] || '';
        const char2 = Array.from(parts[1])[0] || '';
        initialsEl.textContent = (char1 + char2).toUpperCase();
      }
    });
  });
</script>
