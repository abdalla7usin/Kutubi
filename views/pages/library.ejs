<div class="main-container">
  <!-- Header with Editorial Precision -->
  <header class="flex items-center justify-between gap-lg min-h-[40px]">
    <div>
      <p class="text-[11px] font-semibold uppercase tracking-[0.08em] text-text-muted mb-1">Catalog</p>
      <div class="flex items-baseline gap-2">
        <h1 class="text-[26px] font-semibold text-text-primary tracking-tight leading-none">My Library</h1>
        <span class="text-[12px] text-text-muted tabular-nums" id="library-book-count">
          <%= books.length %> <%= books.length === 1 ? 'title' : 'titles' %>
        </span>
      </div>
    </div>
    <a href="/books/new" class="btn btn-primary h-9 flex items-center justify-center gap-xs px-4">
      <span class="material-symbols-outlined text-[16px]" aria-hidden="true">add</span>
      <span>Add Book</span>
    </a>
  </header>

  <!-- Live Filter & Sort Toolbar Form -->
  <form id="library-toolbar-form" action="/library" method="GET" class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3">
    <input type="hidden" name="view" id="library-view-input" value="<%= filters.view %>" />
    <div class="flex flex-1 flex-wrap items-center gap-2">
      <!-- Search Input -->
      <div class="relative flex-1 min-w-[200px] max-w-sm">
        <span class="material-symbols-outlined text-[18px] text-text-muted absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none">
          search
        </span>
        <input
          id="library-search-input"
          name="search"
          type="search"
          value="<%= filters.search %>"
          placeholder="Search by title or author..."
          class="form-input w-full"
          style="padding-left: 36px; height: 34px;"
          dir="auto"
        />
      </div>

      <!-- Status Dropdown -->
      <select id="library-status-select" name="status" class="form-select w-auto" data-prefix="Status: ">
        <option value="All" <%= filters.status === 'All' ? 'selected' : '' %>>All</option>
        <option value="Reading" <%= filters.status === 'Reading' ? 'selected' : '' %>>Reading</option>
        <option value="Completed" <%= filters.status === 'Completed' ? 'selected' : '' %>>Completed</option>
        <option value="To Read" <%= filters.status === 'To Read' ? 'selected' : '' %>>To Read</option>
      </select>

      <!-- Category Dropdown -->
      <select id="library-category-select" name="category" class="form-select w-auto" data-prefix="Category: ">
        <option value="All" <%= filters.category === 'All' ? 'selected' : '' %>>All</option>
        <% categories.forEach(cat => { %>
          <option value="<%= cat.name %>" <%= filters.category === cat.name ? 'selected' : '' %>>
            <%= cat.name %>
          </option>
        <% }); %>
      </select>

      <!-- Sort Dropdown -->
      <select id="library-sort-select" name="sort" class="form-select w-auto" data-prefix="Sort: ">
        <option value="recently-added" <%= filters.sort === 'recently-added' ? 'selected' : '' %>>Recently Added</option>
        <option value="title" <%= filters.sort === 'title' ? 'selected' : '' %>>Title (A–Z)</option>
        <option value="progress" <%= filters.sort === 'progress' ? 'selected' : '' %>>Progress</option>
        <option value="rating" <%= filters.sort === 'rating' ? 'selected' : '' %>>Highest Rated</option>
      </select>
    </div>

    <!-- Segmented Grid/List Toggle -->
    <div role="group" aria-label="View mode" class="inline-flex items-center p-0.5 rounded-control bg-[rgba(255,255,255,0.03)] border border-border-subtle shrink-0 self-start md:self-auto">
      <button
        type="button"
        id="toggle-grid-view"
        aria-pressed="<%= filters.view === 'grid' ? 'true' : 'false' %>"
        class="inline-flex items-center gap-1 px-2.5 py-1 rounded-[5px] <%= filters.view === 'grid' ? 'bg-surface-elevated text-text-primary shadow-sm' : 'text-text-muted hover:text-text-secondary' %> text-[12px] font-medium transition-colors"
      >
        <span class="material-symbols-outlined text-[16px]">grid_view</span>
        <span>Grid</span>
      </button>
      <button
        type="button"
        id="toggle-list-view"
        aria-pressed="<%= filters.view === 'list' ? 'true' : 'false' %>"
        class="inline-flex items-center gap-1 px-2.5 py-1 rounded-[5px] <%= filters.view === 'list' ? 'bg-surface-elevated text-text-primary shadow-sm' : 'text-text-muted hover:text-text-secondary' %> text-[12px] font-medium transition-colors"
      >
        <span class="material-symbols-outlined text-[16px]">view_list</span>
        <span>List</span>
      </button>
    </div>
  </form>

  <!-- Book Content or Empty State -->
  <% if (!books || books.length === 0) { %>
    <!-- Empty State Card -->
    <% const hasActiveFilters = Boolean(filters.search || (filters.status && filters.status !== 'All') || (filters.category && filters.category !== 'All')); %>
    <div class="flex justify-center pt-8">
      <article class="card card-padded max-w-md w-full flex flex-col items-center text-center gap-3 py-12">
        <div class="w-10 h-10 rounded-control bg-surface-elevated border border-border-subtle flex items-center justify-center text-text-muted">
          <span class="material-symbols-outlined text-[20px]"><%= hasActiveFilters ? 'search_off' : 'auto_stories' %></span>
        </div>
        <header class="flex flex-col items-center gap-1">
          <h3 class="text-[15px] font-semibold text-text-primary"><%= hasActiveFilters ? 'No books match your criteria' : 'Your library is empty' %></h3>
          <p class="text-[13px] text-text-secondary"><%= hasActiveFilters ? 'Try adjusting your search terms or clearing active filters.' : 'Start building your personal collection by adding your first book.' %></p>
        </header>
        <footer class="pt-2">
          <% if (hasActiveFilters) { %>
            <a href="/library" id="clear-filters-btn" class="btn btn-secondary">
              <span>Reset Filters</span>
            </a>
          <% } else { %>
            <a href="/books/new" class="btn btn-primary h-9 flex items-center justify-center gap-xs px-4">
              <span class="material-symbols-outlined text-[16px]">add</span>
              <span>Add Your First Book</span>
            </a>
          <% } %>
        </footer>
      </article>
    </div>
  <% } else if (filters.view === 'grid') { %>
    <!-- 4-Column Book Grid -->
    <section aria-label="Books Grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 items-stretch">
      <% books.forEach(book => { %>
        <% const dir = isArabic(book.title) ? 'rtl' : 'ltr'; %>
        <% const percent = calculatePercentage(book.currentPage, book.totalPages); %>
        <% const statusClass = book.status === 'Reading' ? 'badge-status-reading' : (book.status === 'Completed' ? 'badge-status-completed' : 'badge-status-toread'); %>
        
        <a href="/books/<%= book.id %>" class="card card-interactive p-3 flex flex-col justify-between gap-3 h-full group">
          <div class="flex flex-col gap-3">
            <%- renderBookCover(book) %>
            <div class="flex flex-col gap-1 px-0.5" dir="<%= dir %>">
              <h2 class="text-[14px] font-semibold text-text-primary leading-snug line-clamp-2" dir="<%= dir %>">
                <%= book.title %>
              </h2>
              <p class="text-[12px] text-text-secondary line-clamp-1" dir="<%= dir %>">
                <%= book.author %>
              </p>
            </div>
          </div>

          <div class="flex flex-col gap-2 px-0.5">
            <% if (book.status === 'Reading') { %>
              <div class="flex flex-col gap-1">
                <div class="progress-track">
                  <div class="progress-fill" style="width: <%= percent %>%;"></div>
                </div>
                <div class="flex items-center justify-between text-[11px] text-text-secondary tabular-nums">
                  <span><%= book.currentPage %> / <%= book.totalPages %> p.</span>
                  <span class="font-medium text-text-primary"><%= percent %>%</span>
                </div>
              </div>
            <% } %>

            <div class="flex items-center justify-between gap-1 pt-2 border-t border-[rgba(255,255,255,0.04)]">
              <span class="badge badge-category truncate max-w-[110px]"><%= book.category %></span>
              <div class="flex items-center gap-1.5 shrink-0">
                <% if (book.pdfPath) { %>
                  <span class="badge border border-border-subtle bg-surface-elevated text-text-primary px-1.5 py-0 text-[10px]" title="In-App PDF Reader Available">
                    PDF
                  </span>
                <% } %>
                <span class="badge <%= statusClass %>"><%= book.status %></span>
              </div>
            </div>
          </div>
        </a>
      <% }); %>
    </section>
  <% } else { %>
    <!-- List View Table -->
    <section aria-label="Books List" class="data-table-container">
      <table class="data-table">
        <thead>
          <tr>
            <th class="w-[45%]">Book</th>
            <th class="w-[16%]">Category</th>
            <th class="w-[12%]">Status</th>
            <th class="w-[15%]">Progress</th>
            <th class="w-[12%] text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% books.forEach(book => { %>
            <% const dir = isArabic(book.title) ? 'rtl' : 'ltr'; %>
            <% const percent = calculatePercentage(book.currentPage, book.totalPages); %>
            <% const statusClass = book.status === 'Reading' ? 'badge-status-reading' : (book.status === 'Completed' ? 'badge-status-completed' : 'badge-status-toread'); %>
            
            <tr class="group">
              <!-- Book Info -->
              <td>
                <a href="/books/<%= book.id %>" class="flex items-center gap-3 text-inherit">
                  <%- renderListThumbnail(book) %>
                  <div class="min-w-0">
                    <div class="flex items-center gap-2">
                      <p class="text-[13px] font-medium text-text-primary group-hover:text-white transition-colors truncate" dir="<%= dir %>">
                        <%= book.title %>
                      </p>
                      <% if (book.pdfPath) { %>
                        <span class="badge border border-border-subtle bg-surface-elevated text-text-primary px-1 py-0 text-[10px]" title="PDF Attached">PDF</span>
                      <% } %>
                    </div>
                    <p class="text-[12px] text-text-secondary truncate mt-0.5" dir="<%= dir %>">
                      <%= book.author %>
                    </p>
                  </div>
                </a>
              </td>

              <!-- Category -->
              <td>
                <span class="badge badge-category"><%= book.category %></span>
              </td>

              <!-- Status -->
              <td>
                <span class="badge <%= statusClass %>"><%= book.status %></span>
              </td>

              <!-- Reading Progress -->
              <td>
                <div class="flex flex-col gap-1 max-w-[130px]">
                  <div class="progress-track">
                    <div class="progress-fill" style="width: <%= percent %>%;"></div>
                  </div>
                  <span class="text-[11px] text-text-muted tabular-nums">
                    <%= book.currentPage %>/<%= book.totalPages %> (<%= percent %>%)
                  </span>
                </div>
              </td>

              <!-- Actions -->
              <td class="text-right">
                <div class="inline-flex items-center gap-1">
                  <% if (book.pdfPath) { %>
                    <a href="/books/<%= book.id %>/read" class="btn-icon" title="Read Book">
                      <span class="material-symbols-outlined text-[16px]">menu_book</span>
                    </a>
                  <% } %>
                  <a href="/books/<%= book.id %>/edit" class="btn-icon" title="Edit Book">
                    <span class="material-symbols-outlined text-[16px]">edit</span>
                  </a>
                  <button
                    type="button"
                    class="btn-icon hover:text-danger"
                    data-delete-book-id="<%= book.id %>"
                    data-delete-book-title="<%= book.title %>"
                    title="Delete Book"
                  >
                    <span class="material-symbols-outlined text-[16px]">delete</span>
                  </button>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </section>
  <% } %>
</div>
