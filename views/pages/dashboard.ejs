<div class="main-container">
  <!-- Header with Editorial Precision -->
  <header class="flex items-center justify-between gap-lg min-h-[40px]">
    <div>
      <p class="text-[11px] font-semibold uppercase tracking-[0.08em] text-text-muted mb-1">Overview</p>
      <h1 class="text-[26px] font-semibold text-text-primary tracking-tight leading-none">Dashboard</h1>
    </div>
    <a href="/books/new" class="btn btn-primary h-9 flex items-center justify-center gap-xs px-4" id="dashboard-add-book-btn">
      <span class="material-symbols-outlined text-[16px]" aria-hidden="true">add</span>
      <span>Add Book</span>
    </a>
  </header>

  <!-- 4 Top Metrics Cards -->
  <section aria-label="Library Summary" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-md items-stretch">
    <!-- Total Books -->
    <article class="card card-padded flex flex-col justify-between gap-md h-full">
      <span class="text-[11px] font-semibold uppercase tracking-[0.06em] text-text-muted">Total Books</span>
      <div class="flex flex-col gap-1">
        <span class="text-[30px] font-semibold text-text-primary tabular-nums tracking-tight leading-none" id="metric-total-books"><%= metrics.totalBooks %></span>
        <span class="text-[12px] text-text-secondary">Across <%= metrics.categoriesCount %> categories</span>
      </div>
    </article>

    <!-- Currently Reading -->
    <article class="card card-padded flex flex-col justify-between gap-md h-full">
      <span class="text-[11px] font-semibold uppercase tracking-[0.06em] text-text-muted">Currently Reading</span>
      <div class="flex flex-col gap-1">
        <span class="text-[30px] font-semibold text-text-primary tabular-nums tracking-tight leading-none" id="metric-reading-books"><%= metrics.reading %></span>
        <span class="text-[12px] text-text-secondary">Active in progress</span>
      </div>
    </article>

    <!-- Completed -->
    <article class="card card-padded flex flex-col justify-between gap-md h-full">
      <span class="text-[11px] font-semibold uppercase tracking-[0.06em] text-text-muted">Completed</span>
      <div class="flex flex-col gap-1">
        <span class="text-[30px] font-semibold text-text-primary tabular-nums tracking-tight leading-none" id="metric-completed-books"><%= metrics.completed %></span>
        <span class="text-[12px] text-text-secondary tabular-nums"><%= metrics.completedPercent %>% of library</span>
      </div>
    </article>

    <!-- To Read -->
    <article class="card card-padded flex flex-col justify-between gap-md h-full">
      <span class="text-[11px] font-semibold uppercase tracking-[0.06em] text-text-muted">To Read</span>
      <div class="flex flex-col gap-1">
        <span class="text-[30px] font-semibold text-text-primary tabular-nums tracking-tight leading-none" id="metric-toread-books"><%= metrics.toRead %></span>
        <span class="text-[12px] text-text-secondary">Queued next</span>
      </div>
    </article>
  </section>

  <!-- Currently Reading Section -->
  <section id="currently-reading-section" class="flex flex-col gap-md">
    <div class="flex items-center justify-between pb-1">
      <div class="flex items-center gap-2">
        <h2 class="text-[15px] font-semibold text-text-primary tracking-tight">Currently Reading</h2>
        <span class="text-[11px] font-medium text-text-muted tabular-nums bg-surface-elevated px-2 py-0.5 rounded border border-border-subtle"><%= currentlyReading ? currentlyReading.length : 0 %></span>
      </div>
      <a href="/library?status=Reading" class="text-[12px] font-medium text-text-secondary hover:text-text-primary transition-colors">View all &rarr;</a>
    </div>

    <% if (!currentlyReading || currentlyReading.length === 0) { %>
      <div class="card card-padded text-center py-10">
        <p class="text-[13px] text-text-secondary">No books currently in progress.</p>
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-md items-stretch">
        <% currentlyReading.forEach(book => { %>
          <% const dir = isArabic(book.title) ? 'rtl' : 'ltr'; %>
          <a href="/books/<%= book.id %>" class="card card-interactive p-md flex gap-md h-full">
            <div class="w-[72px] aspect-[2/3] rounded-cover overflow-hidden shrink-0 book-cover-container">
              <% const effectiveCover = getEffectiveCoverUrl(book); %>
              <% if (effectiveCover) { %>
                <img
                  src="<%= effectiveCover %>"
                  alt="<%= book.title %> cover"
                  class="book-cover-img"
                  loading="lazy"
                  onerror="window.handleCoverError && window.handleCoverError(this, '<%= book.title.replace(/'/g, "\\'") %>', '<%= book.author.replace(/'/g, "\\'") %>')"
                />
              <% } else { %>
                <%- renderTypographicCover(book.title, book.author, true) %>
              <% } %>
            </div>
            <div class="flex-1 min-w-0 flex flex-col justify-between gap-md" dir="<%= dir %>">
              <div class="flex flex-col gap-1">
                <span class="self-start inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-surface-elevated border border-border-subtle text-text-secondary">
                  <%= book.category %>
                </span>
                <h3 class="text-[14px] font-semibold text-text-primary leading-snug line-clamp-2 mt-1" dir="<%= dir %>">
                  <%= book.title %>
                </h3>
                <p class="text-[12px] text-text-secondary line-clamp-1" dir="<%= dir %>">
                  <%= book.author %>
                </p>
              </div>
              <div class="flex flex-col gap-1.5 pt-1" dir="ltr">
                <div class="progress-track">
                  <div class="progress-fill" style="width: <%= book.progressPercent %>%;"></div>
                </div>
                <div class="flex items-center justify-between text-[11px] text-text-secondary tabular-nums">
                  <span><%= book.currentPage %> / <%= book.totalPages %> p.</span>
                  <span class="font-medium text-text-primary"><%= book.progressPercent %>%</span>
                </div>
              </div>
            </div>
          </a>
        <% }); %>
      </div>
    <% } %>
  </section>

  <!-- Recently Added Section -->
  <section id="recently-added-section" class="flex flex-col gap-md">
    <div class="flex items-center justify-between pb-1">
      <h2 class="text-[15px] font-semibold text-text-primary tracking-tight">Recently Added</h2>
    </div>

    <% if (!recentlyAdded || recentlyAdded.length === 0) { %>
      <div class="card card-padded text-center py-10">
        <p class="text-[13px] text-text-secondary">No books added yet.</p>
      </div>
    <% } else { %>
      <div class="card divide-y divide-[rgba(255,255,255,0.04)] overflow-hidden">
        <% recentlyAdded.forEach(book => { %>
          <% const dir = isArabic(book.title) ? 'rtl' : 'ltr'; %>
          <% const statusClass = book.status === 'Reading' ? 'badge-status-reading' : (book.status === 'Completed' ? 'badge-status-completed' : 'badge-status-toread'); %>
          <a href="/books/<%= book.id %>" class="flex items-center justify-between gap-lg px-5 py-3 hover:bg-[rgba(255,255,255,0.025)] transition-colors text-inherit">
            <div class="flex items-center gap-3 min-w-0">
              <%- renderListThumbnail(book) %>
              <div class="min-w-0">
                <div class="flex items-center gap-2">
                  <p class="text-[13px] font-medium text-text-primary truncate" dir="<%= dir %>">
                    <%= book.title %>
                  </p>
                  <% if (book.pdfPath) { %>
                    <span class="badge border border-border-subtle bg-surface-elevated text-text-primary px-1.5 py-0 text-[10px]" title="PDF Document Attached">PDF</span>
                  <% } %>
                </div>
                <p class="text-[12px] text-text-secondary truncate mt-0.5" dir="<%= dir %>">
                  <%= book.author %>
                </p>
              </div>
            </div>
            <div class="flex items-center gap-3 sm:gap-4 shrink-0">
              <span class="badge badge-category hidden sm:inline-flex"><%= book.category %></span>
              <span class="badge <%= statusClass %>"><%= book.status %></span>
              <span class="text-[12px] text-text-muted tabular-nums w-[80px] text-right"><%= book.dateAdded %></span>
            </div>
          </a>
        <% }); %>
      </div>
    <% } %>
  </section>
</div>
